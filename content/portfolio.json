    "experience-1-description": {
      "type": "text",
      "label": "experience-1-description",
      "value": "Designed and developed an automated, cloud-based web vulnerability scanner using Python and FastAPI. Built custom security testing modules for web applications and REST APIs, integrated offensive security tools, and implemented AI-assisted vulnerability reporting with actionable remediation guidance."
    },
